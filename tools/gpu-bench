#!/bin/sh
# Device benchmark lives within the platform adapter; other tools remain
# displayless. Additional arguments configure the opt-in benchmark only.
set -e
cd "$(git rev-parse --show-toplevel)"
# Benchmarks keep their documented two-worker budget; gates default higher.
: "${GOMAXPROCS:=2}"
: "${NANOLATHE_TEST_P:=2}"
. tools/go-budget
NANOLATHE_GPU_BENCH=1 tools/host-run go test ./internal/platform/ebitenapp -run '^TestGPUModelBenchmark$' -count=1 -v -args "$@"
