#!/usr/bin/env python3
"""Cheap process checks for gate slots, benchmark exclusion, inherited
ownership, crash release and exit status."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

runner = str(Path(__file__).with_name("host-run").resolve())
HOLD = [sys.executable, "-c", "import sys; print('held', flush=True); sys.stdin.read()"]

with tempfile.TemporaryDirectory() as tmp:
    env = dict(os.environ, HOME=tmp, XDG_CACHE_HOME=tmp, NANOLATHE_GATE_SLOTS="2")
    env.pop("NANOLATHE_HOST_LOCK_FD", None)
    processes = []

    def start(*command):
        process = subprocess.Popen(
            [runner, *command], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            text=True, env=env, cwd=tmp,
        )
        processes.append(process)
        return process

    def holding(process):
        assert process.stdout.readline().strip() == "held"
        return process

    def waiting(process, what):
        line = process.stdout.readline()
        assert what in line, line
        assert process.poll() is None

    def release(process):
        process.kill()
        process.wait(timeout=5)

    try:
        # A benchmark excludes another benchmark; a nested run inside the
        # waiter does not reacquire, and a killed holder releases.
        bench = holding(start(*HOLD))
        waiter = start(runner, sys.executable, "-c", "print('nested acquired')")
        waiting(waiter, "waiting for running verification gates or another benchmark")
        # A gate waits while a benchmark measures.
        gate = start("--gate", *HOLD)
        waiting(gate, "waiting for a running benchmark")
        release(bench)
        assert waiter.communicate(timeout=5)[0].strip() == "nested acquired"
        assert waiter.returncode == 0
        holding(gate)

        # Gates share the host: a second gate runs beside the first, a third
        # waits for a slot, and a benchmark waits for every gate.
        second = holding(start("--gate", *HOLD))
        third = start("--gate", *HOLD)
        waiting(third, "one of 2 verification gate slots")
        bench = start(*HOLD)
        waiting(bench, "waiting for running verification gates")
        release(gate)
        holding(third)
        assert bench.poll() is None
        release(second)
        release(third)
        holding(bench)
        release(bench)

        # A command's failure must remain a failure at the gate boundary.
        for mode in ([], ["--gate"]):
            result = subprocess.run(
                [runner, *mode, sys.executable, "-c", "raise SystemExit(7)"],
                env=env, timeout=5,
            )
            assert result.returncode == 7
    finally:
        for process in processes:
            if process.poll() is None:
                process.kill()
            process.wait()
print("host-run: gate slots, benchmark exclusion, nested ownership, crash release and exit status passed")
