#!/usr/bin/env python3
"""Serialize expensive local tools with the engine's existing benchmark lock.

macOS/Linux developer helper; uses only Python's standard library. The lock
file must never be deleted: all checkouts and native benchmarks share it.
"""
import fcntl
import os
from pathlib import Path
import sys

if len(sys.argv) < 2:
    sys.exit("usage: tools/host-run COMMAND [ARG ...]")
# Nested gates/lint inherit the held descriptor, so they must not reacquire it.
held = os.environ.get("NANOLATHE_HOST_LOCK_FD")
if held:
    try:
        os.fstat(int(held))
    except (ValueError, OSError):
        sys.exit("nanolathe: inherited host lock descriptor is invalid")
else:
    if sys.platform == "darwin":
        cache = Path.home() / "Library/Caches"
    else:
        cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
        if not cache.is_absolute():
            sys.exit("nanolathe: XDG_CACHE_HOME must be absolute")
    path = cache / "nanolathe/battle-bench.lock"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("==> waiting for another verification or benchmark run", flush=True)
        fcntl.flock(fd, fcntl.LOCK_EX)
    os.set_inheritable(fd, True)
    os.environ["NANOLATHE_HOST_LOCK_FD"] = str(fd)
os.execvp(sys.argv[1], sys.argv[1:])
