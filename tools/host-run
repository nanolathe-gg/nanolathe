#!/usr/bin/env python3
"""Coordinate expensive local tools across worktrees.

macOS/Linux developer helper; uses only Python's standard library. The lock
files must never be deleted: every checkout and native benchmark shares them.

  tools/host-run COMMAND ...          benchmark: exclusive host lock
  tools/host-run --gate COMMAND ...   verification gate: one of N gate slots

Benchmarks exclude one another through the host lock, which the native
benchmark binaries also take through internal/platform/benchlock. Up to
NANOLATHE_GATE_SLOTS gates (default 3) run side by side. The two classes never
wait for each other: a landing must not stall behind a long benchmark sweep, so
a benchmark reports when gates are running beside it and its timings are
noisier for that. Research sweeps and focused `go test` runs take neither lock.
"""
import fcntl
import os
from pathlib import Path
import sys
import time

args = sys.argv[1:]
gate = bool(args) and args[0] == "--gate"
if gate:
    args = args[1:]
if not args:
    sys.exit("usage: tools/host-run [--gate] COMMAND [ARG ...]")


def lock_dir():
    if sys.platform == "darwin":
        cache = Path.home() / "Library/Caches"
    else:
        cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
        if not cache.is_absolute():
            sys.exit("nanolathe: XDG_CACHE_HOME must be absolute")
    path = cache / "nanolathe"
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    return path


def open_lock(path):
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    os.set_inheritable(fd, True)
    return fd


def try_lock(fd, mode):
    try:
        fcntl.flock(fd, mode | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def wait_message(what):
    print(f"==> waiting for {what}", flush=True)


def gate_slot_count():
    try:
        slots = int(os.environ.get("NANOLATHE_GATE_SLOTS", "3"))
    except ValueError:
        slots = 0
    if slots < 1:
        sys.exit("nanolathe: NANOLATHE_GATE_SLOTS must be a positive integer")
    return slots


# Nested gates/lint inherit the held descriptors, so they must not reacquire.
held = os.environ.get("NANOLATHE_HOST_LOCK_FD")
if held:
    try:
        os.fstat(int(held))
    except (ValueError, OSError):
        sys.exit("nanolathe: inherited host lock descriptor is invalid")
else:
    directory = lock_dir()
    slots = gate_slot_count()
    if gate:
        fds = [open_lock(directory / f"gate-slot-{i}.lock") for i in range(slots)]
        owned = None
        announced = False
        while owned is None:
            owned = next((fd for fd in fds if try_lock(fd, fcntl.LOCK_EX)), None)
            if owned is None:
                if not announced:
                    wait_message(f"one of {slots} verification gate slots")
                    announced = True
                time.sleep(1)
        for fd in fds:
            if fd != owned:
                os.close(fd)
        held_fd = owned
    else:
        host = open_lock(directory / "battle-bench.lock")
        if not try_lock(host, fcntl.LOCK_EX):
            wait_message("another benchmark")
            fcntl.flock(host, fcntl.LOCK_EX)
        # Probe the slots without taking them: a held slot is a running gate.
        busy = 0
        for i in range(slots):
            probe = os.open(directory / f"gate-slot-{i}.lock", os.O_CREAT | os.O_RDWR, 0o600)
            if try_lock(probe, fcntl.LOCK_EX):
                fcntl.flock(probe, fcntl.LOCK_UN)
            else:
                busy += 1
            os.close(probe)
        if busy:
            print(f"==> note: {busy} verification gate(s) running beside this benchmark; timings are noisier", flush=True)
        held_fd = host
    os.environ["NANOLATHE_HOST_LOCK_FD"] = str(held_fd)
os.execvp(args[0], args)
