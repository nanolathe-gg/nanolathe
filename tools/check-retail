#!/bin/sh
# Integration gate: short retail contracts. --full adds long acceptance runs.
#
# tools/check is the fast tier and the one CI runs; it skips every asset-gated
# test. This gate opts in, so the whole-corpus catalog compiles, the map and
# mission censuses execute. Extended match trajectories require --full.
#
# Point it at an install with $NANOLATHE_RETAIL_ASSETS, or let it default to
# ~/TotalAnnihilation. An unreadable root fails loudly rather than skipping,
# so a typo cannot masquerade as a green run.
#
# It also runs the modern executor's authored device pixel fixtures when the
# session has a window server; without one it says SKIPPED, because a missing
# graphics device is a property of the machine, not of the change.
set -e

if [ -z "${NANOLATHE_HOST_LOCK_FD:-}" ]; then
	exec "$(dirname "$0")/host-run" --gate "$0" "$@"
fi
. "$(dirname "$0")/go-budget"

# Long acceptance trajectories are explicit; focused retail contracts remain.
short=true
fresh=false
while [ "$#" -gt 0 ]; do
	case "$1" in
	--full) short=false; shift ;;
	--fresh) fresh=true; shift ;;
	--) shift; break ;;
	*) break ;;
	esac
done
[ "$#" -gt 0 ] || set -- ./...
whole_tree=false
if [ "$#" -eq 1 ] && [ "$1" = ./... ]; then
	whole_tree=true
fi

if [ -z "${NANOLATHE_RETAIL_ASSETS:-}" ] && [ -n "${NANOLATHE_TA_ROOT:-}" ]; then
	NANOLATHE_RETAIL_ASSETS="$NANOLATHE_TA_ROOT"
fi
: "${NANOLATHE_RETAIL_ASSETS:=$HOME/TotalAnnihilation}"
export NANOLATHE_RETAIL_ASSETS

if [ ! -d "$NANOLATHE_RETAIL_ASSETS" ]; then
	echo "nanolathe: retail assets not found: logical path $NANOLATHE_RETAIL_ASSETS, providers searched [\$NANOLATHE_RETAIL_ASSETS, \$NANOLATHE_TA_ROOT, \$HOME/TotalAnnihilation], expected a directory of HPI archives" >&2
	exit 1
fi

echo "==> retail assets: $NANOLATHE_RETAIL_ASSETS"

# -tags retail adds every file carrying `//go:build retail` to the build; it
# excludes no files. -short skips only documented long acceptance trajectories.
# Without the tag those files are never compiled, which is how the tagged tier
# came to be red on main without anyone noticing.
echo "==> lint (staticcheck + deadcode, retail tag)"
"$(dirname "$0")/lint"

echo "==> go vet (retail tag)"
go vet -tags retail "$@"
# The opt-in path benchmark (docs/PATH_BENCHMARK.md) builds only under its own
# tag, so no other step compiles it; vetting it here keeps the suite buildable.
echo "==> go vet (path benchmark tags)"
go vet -tags 'pathbench retail' ./internal/session ./cmd/nanolathe
echo "==> go test (retail corpus, tagged, short=$short)"
# Bounded for the same reason as tools/check, and it matters more here: each
# package binary that opts in holds a compiled retail catalog.
# The reference retail install is immutable during normal development. Reuse
# Go's test cache; --fresh is required after changing assets in place.
[ "$fresh" = false ] || set -- -count=1 "$@"
# The three reserved gameplay modes make the command package's combined retail
# trajectories longer than Go's ten-minute default on development machines.
go test -tags retail -short="$short" -p "$NANOLATHE_TEST_P" -timeout "${NANOLATHE_TEST_TIMEOUT:-20m}" "$@"

# M1-C11: execute the same locked constants on amd64, not just a cross-build.
# Keep every fingerprint lock (including the Strict pool-fill scene) in this
# selection. Scoped package arguments must not narrow this ratchet.
# fingerprint_packages holds every lock: the rule-set scenes in
# internal/headless and the Modern AI's online lock in mods/aikit, the one
# lock that runs the util+tac controller every client hosts online.
fingerprint_packages="./internal/headless ./mods/aikit"
run_amd64_fingerprints() {
	set -- -tags retail -short="$short" -p "$NANOLATHE_TEST_P" \
		-timeout "${NANOLATHE_TEST_TIMEOUT:-20m}" -run '^Test.*Fingerprint.*Locked$' "$@"
	[ "$fresh" = false ] || set -- -count=1 "$@"
	# shellcheck disable=SC2086 # the package list splits on spaces
	GOOS="$host_os" GOARCH=amd64 go test "$@" $fingerprint_packages
	echo "==> amd64 fingerprint locks: PASSED"
}
host_os=$(go env GOHOSTOS)
host_arch=$(go env GOHOSTARCH)
echo "==> amd64 fingerprint locks (short=$short)"
case "$host_os/$host_arch" in
*/amd64)
	if [ "$whole_tree" = true ] && [ "$(go env GOOS)/$(go env GOARCH)" = "$host_os/amd64" ]; then
		echo "==> amd64 fingerprint locks: PASSED (covered by the native retail suite above)"
	else
		run_amd64_fingerprints
	fi
	;;
darwin/arm64)
	# This system binary probes Rosetta independently of our test executable.
	# Once the probe succeeds, compilation or execution failures are failures;
	# never turn a broken lock into an unsupported-host skip.
	if /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null; then
		run_amd64_fingerprints -exec '/usr/bin/arch -x86_64'
	else
		echo "==> amd64 fingerprint locks: SKIPPED (Rosetta cannot execute amd64 on this host)"
	fi
	;;
*)
	echo "==> amd64 fingerprint locks: SKIPPED (no supported amd64 execution path on $host_os/$host_arch)"
	;;
esac

# The browser build runs under Node here. Node 22 is the first release with a
# global WebSocket, which the browser's relay client uses as it does in a page.
wasm_node_available() {
	node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null) || return 1
	[ "$node_major" -ge 22 ] 2>/dev/null
}

# The browser build plays online beside native seats, so it executes the same
# fingerprint selection as the amd64 step (DESIGN_MULTIPLAYER §16.1). Go's
# wasm port has one thread, so the binary runs with GOMAXPROCS=1 whatever
# budget the compiler uses.
run_wasm_fingerprints() {
	set -- -tags retail -short="$short" -timeout "${NANOLATHE_TEST_TIMEOUT:-20m}" \
		-run '^Test.*Fingerprint.*Locked$' \
		-exec "env GOMAXPROCS=1 $(go env GOROOT)/lib/wasm/go_js_wasm_exec"
	[ "$fresh" = false ] || set -- -count=1 "$@"
	# shellcheck disable=SC2086 # the package list splits on spaces
	GOOS=js GOARCH=wasm go test "$@" $fingerprint_packages
	echo "==> js/wasm fingerprint locks: PASSED"
}
echo "==> js/wasm fingerprint locks (short=$short)"
if wasm_node_available; then
	run_wasm_fingerprints
else
	echo "==> js/wasm fingerprint locks: SKIPPED (Node 22 or later is not on PATH)"
fi

# A js/wasm client plays a hosted match through Node's WebSocket against a
# native relay on loopback (DESIGN_MULTIPLAYER §16.5.1). It needs no assets.
echo "==> js/wasm relay client"
if wasm_node_available; then
	NANOLATHE_WASM_RELAY=1 go test -count=1 -run '^TestWasmClientPlaysHostedMatch$' ./internal/relay
	echo "==> js/wasm relay client: PASSED"
else
	echo "==> js/wasm relay client: SKIPPED (Node 22 or later is not on PATH)"
fi

# The modern executor's authored pixel fixtures are the only pixel-level lock on
# the model lane, the pass scheduler and the Enhanced effect layers, and they can
# only run against a real graphics device (C-G10). Most need no retail assets,
# but this is the tier that runs on a developer machine, so this is where they
# belong — and the run inherits the exported retail root above, so the few
# fixtures that render the installed art opt themselves in here rather than
# returning early as they do on a bare device run.
#
# They run as their OWN `go test` invocation, deliberately. Ebitengine allows one
# RunGame per process and rejects image allocation once it returns, so the
# package's TestMain hosts every device check inside a single hidden loop and the
# fixtures that build a renderer afterwards skip themselves. Setting the variable
# for the main run above would therefore silently eat the scheduler and atlas
# fixtures that the untagged run is supposed to cover. A separate process keeps
# both sets honest: the run above sees no device loop, this one is nothing else.
#
# -run selects the loop's reporter; TestMain runs the loop regardless of the
# filter, and every other device test in the package reports the same single
# result, so this one invocation covers all of them.
echo "==> GPU device fixtures (modern executor, real device)"
device_display_available() {
	case "$(uname -s)" in
	Darwin)
		# A headless session (ssh, a launchd daemon) reports something other
		# than Aqua; only an Aqua session has a window server to open on.
		[ "$(launchctl managername 2>/dev/null)" = "Aqua" ]
		;;
	*)
		[ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
		;;
	esac
}
if device_display_available; then
	NANOLATHE_GPU_DEVICE_TEST=1 go test -tags retail ./internal/platform/gpurender \
		-run '^TestDeviceFixtureLoop$' -count=1
	echo "==> GPU device fixtures: PASSED"
else
	# Say SKIPPED, not OK. A gate that reports a fixture it never ran as passing
	# is worse than one that does not run it at all.
	echo "==> GPU device fixtures: SKIPPED (no window server on this session; run tools/check-retail on a machine with a display before merging renderer work)"
fi

# The macOS Metal renderer compiles its shader library when the game starts,
# so only a real device finds a shader or pipeline error. Its device test
# builds the whole offscreen renderer from TestMain on the main thread
# (docs/DESIGN_METAL_RENDERER.md §9).
echo "==> Metal renderer device test (macOS)"
if [ "$(uname -s)" = Darwin ] && device_display_available; then
	NANOLATHE_METAL_DEVICE_TEST=1 go test ./internal/platform/metalrender \
		-run '^TestDevicePipelines$' -count=1
	echo "==> Metal renderer device test: PASSED"
else
	echo "==> Metal renderer device test: SKIPPED (needs macOS with a window server)"
fi

echo "OK"
