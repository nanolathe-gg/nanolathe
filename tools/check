#!/bin/sh
# Pre-dispatch and pre-merge gate. See docs/ORCHESTRATION.md §5.
set -e
echo "==> gofmt"
unformatted=$(gofmt -l . || true)
if [ -n "$unformatted" ]; then
	echo "not gofmt-clean:"
	echo "$unformatted"
	exit 1
fi
echo "==> go build"
go build ./...
echo "==> go vet"
go vet ./...
echo "==> go test"
go test ./...
echo "OK"
