#!/bin/sh
# Render a film script straight into a video file. Retail assets required.
#
#   tools/film <script.json> <out.mp4> [extra --film flags]
#
# The capture streams packed RGBA on stdout and ffmpeg encodes it; nothing
# intermediate is written, so a 4K reel costs no disk beyond the result. Frame
# pacing comes from the script's fps, not from how long a frame took to
# compose. See docs/FILM_CAPTURE.md.
set -eu
if [ $# -lt 2 ]; then
	echo "usage: tools/film <script.json> <out.mp4> [--film-frames N] [--root DIR]" >&2
	exit 2
fi
script=$1
out=$2
shift 2
cd "$(git rev-parse --show-toplevel)"
script=$(cd "$(dirname "$script")" && pwd)/$(basename "$script")
case $out in
/*) ;;
*) out=$PWD/$out ;;
esac
command -v ffmpeg >/dev/null || { echo "nanolathe: film: ffmpeg is not on PATH" >&2; exit 1; }

# The script owns the frame size and rate; read them back so the encoder is
# told the same numbers rather than a second copy of them.
read -r width height fps <<EOF2
$(python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); print(s.get("width",1920), s.get("height",1080), s.get("fps",60))' "$script")
EOF2

# A build inside a git worktree carries no VCS stamp; keep the binary out of
# the pipe by building it first, so only frames reach ffmpeg's stdin.
bin=$(mktemp -d)/nanolathe-film
go build -o "$bin" ./cmd/nanolathe
trap 'rm -rf "$(dirname "$bin")"' EXIT

"$bin" --film "$script" --film-out - "$@" |
	ffmpeg -hide_banner -loglevel warning -y \
		-f rawvideo -pixel_format rgba -video_size "${width}x${height}" -framerate "$fps" \
		-i - -an \
		-c:v libx264 -preset slow -crf 16 -pix_fmt yuv420p -movflags +faststart \
		"$out"
echo "nanolathe: film: wrote $out (${width}x${height} at ${fps} FPS)" >&2
