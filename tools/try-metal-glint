#!/bin/sh
# Modern-renderer metallic glint demo. Ctrl+Shift+G toggles the finish live.
set -eu
cd "$(dirname "$0")/.."
trial_dir=$(mktemp -d "${TMPDIR:-/tmp}/nanolathe-metal-glint.XXXXXX")
trap 'rm -f "$trial_dir/nanolathe"' EXIT
go build -o "$trial_dir/nanolathe" ./cmd/nanolathe
if [ "${1:-}" = battle ]; then
    shift
    "$trial_dir/nanolathe" --renderer=modern --battle-benchmark="$trial_dir/battle" --benchmark-tps=60 --benchmark-frames=1200 --auto-remaster=false "$@"
else
    "$trial_dir/nanolathe" --renderer=modern --fullscreen=false "$@"
fi
