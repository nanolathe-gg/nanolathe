#!/bin/sh
# Live simulation plus rendering, retail assets required. Output directory must be new.
set -eu
cd "$(git rev-parse --show-toplevel)"
. tools/go-budget
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
tools/host-run go build -o "$work/nanolathe" ./cmd/nanolathe
"$work/nanolathe" "$@"
