#!/usr/bin/env python3
"""Summarize one or more battle benchmark directories; compare like metadata only."""
import json
import pathlib
import statistics
import sys

if len(sys.argv) < 2:
    raise SystemExit("usage: tools/battle-bench-report OUTPUT_DIRECTORY [OUTPUT_DIRECTORY ...]")
baseline_metadata = None
baseline_path = None
for directory in sys.argv[1:]:
    path = pathlib.Path(directory)
    data = json.loads((path / "frames.json").read_text())
    rows = data["rows"]
    print(f"\n{path}: {data['renderer']}; {len(rows)} measured frames")
    print(json.dumps(data["metadata"], sort_keys=True))
    # Compare every scene setting, including fields added by future fixtures.
    # Asset installation paths and renderer choice may differ deliberately;
    # build revisions live outside scene metadata and are expected to differ.
    metadata = {key: value for key, value in data["metadata"].items()
                if key not in ("root", "renderer")}
    if baseline_metadata is None:
        baseline_metadata, baseline_path = metadata, path
    else:
        changed = [key for key in sorted(metadata.keys() | baseline_metadata.keys())
                   if key not in metadata or key not in baseline_metadata
                   or metadata[key] != baseline_metadata[key]]
        if changed:
            print(f"WARNING: scene metadata differs from {baseline_path}; timings are not a like-for-like comparison:")
            for key in changed:
                before = json.dumps(baseline_metadata[key], sort_keys=True) if key in baseline_metadata else "<missing>"
                after = json.dumps(metadata[key], sort_keys=True) if key in metadata else "<missing>"
                print(f"  {key}: {before} -> {after}")
    if not rows:
        print("WARNING: no measured frames; timings and workload cannot be assessed")
        continue
    for key in ("Step", "Record", "PreRecord", "CPURender", "Submit", "Cadence"):
        if key == "CPURender" and data["renderer"] == "modern":
            continue
        if key == "PreRecord" and not any(row.get("PreRecord") for row in rows):
            continue
        values = sorted(row.get(key, 0.0) for row in rows)
        print(f"{key:12} mean {statistics.mean(values):8.3f}  median {statistics.median(values):8.3f}  "
              f"p95 {values[min(len(values)-1, int(len(values)*.95))]:8.3f}  max {values[-1]:8.3f} ms")
    # Record/submit pipeline (docs/DESIGN_GPU_RENDERER.md §13.10). A hit
    # presented a list recorded on the pipeline goroutine during the previous
    # frame's flush and present; PreRecord above is that record's own wall
    # time, which is off the game goroutine's critical path. Record is the
    # critical path: the join wait plus any synchronous re-record.
    if any("Hit" in row for row in rows):
        hits = sum(bool(row.get("Hit")) for row in rows)
        hit_rows = [row for row in rows if row.get("Hit")]
        miss_rows = [row for row in rows if not row.get("Hit")]
        print(f"Pipeline: {hits}/{len(rows)} hits ({100*hits/len(rows):.0f}%), {len(miss_rows)} misses")
        for label, subset in (("hit", hit_rows), ("miss", miss_rows)):
            if not subset:
                continue
            for key in ("Record", "Cadence"):
                values = sorted(row[key] for row in subset)
                print(f"  {label:4} {key:9} median {statistics.median(values):8.3f}  p95 "
                      f"{values[min(len(values)-1, int(len(values)*.95))]:8.3f} ms")
    # Persistent model slots (docs/DESIGN_GPU_RENDERER.md §13.12). Reuse is the
    # share of a frame's subjects that kept the slot an earlier frame
    # rasterized; the rest were placed and drawn by this frame.
    if any("SlotsRasterized" in row.get("Stats", {}) for row in rows):
        stats = [row.get("Stats", {}) for row in rows]
        totals = [s.get("SlotsReused", 0) + s.get("SlotsRasterized", 0) for s in stats]
        shares = [100.0 * s.get("SlotsReused", 0) / t for s, t in zip(stats, totals) if t]
        if shares:
            shares.sort()
            print(f"Slot reuse: median {statistics.median(shares):5.1f}%  min {shares[0]:5.1f}%  max {shares[-1]:5.1f}%")
        # The shadow lane's own share (§13.12 "Shadows — contract P4"). Shadows
        # are about two fifths of a battle frame's subjects, so a collapse here
        # is the first thing to check when the overall share falls.
        if any("ShadowSlotsRasterized" in s for s in stats):
            shadow_totals = [s.get("ShadowSlotsReused", 0) + s.get("ShadowSlotsRasterized", 0) for s in stats]
            shadow_shares = sorted(100.0 * s.get("ShadowSlotsReused", 0) / t
                                   for s, t in zip(stats, shadow_totals) if t)
            if shadow_shares:
                print(f"Shadow slot reuse: median {statistics.median(shadow_shares):5.1f}%  "
                      f"min {shadow_shares[0]:5.1f}%  max {shadow_shares[-1]:5.1f}%")
        keys = ["SlotsReused", "SlotsRasterized", "SlotsResident", "SlotEvictions", "SlotOverflows", "RasterPixels"]
        if any("ShadowSlotsRasterized" in s for s in stats):
            keys[2:2] = ["ShadowSlotsReused", "ShadowSlotsRasterized"]
        for key in keys:
            values = sorted(s.get(key, 0) for s in stats)
            print(f"{key:21} median {statistics.median(values):10.0f}  p95 "
                  f"{values[min(len(values)-1, int(len(values)*.95))]:10.0f}  max {values[-1]:10.0f}")

    tps = data.get("tps") or 30
    budget = 1000.0 / tps * 1.05
    on_cadence = sum(row["Cadence"] <= budget for row in rows)
    print(f"On cadence at {tps} Hz (<= {budget:.1f} ms): {on_cadence}/{len(rows)} frames ({100*on_cadence/len(rows):.0f}%)")
    print(f"Alloc: {data['alloc_bytes']/len(rows)/1e6:.3f} MB/frame, "
          f"{data['mallocs']/len(rows):.1f} objects/frame; GC {data['gc']}")
    census = [row.get("Census", {}) for row in rows]
    for key in ("units", "moving_units", "damaged_units", "projectiles", "effects", "fragments",
                "features", "sprite_features", "burning_features", "in_view_sprite_features",
                "in_view_burning_features", "builds", "nanoframes", "nanolathe_events", "shake"):
        values = [sample[key] for sample in census if key in sample]
        if not values:
            continue
        print(f"{key}: {min(values)}..{max(values)}; present in {sum(bool(v) for v in values)} frames")
        if len(values) != len(rows):
            print(f"  WARNING: {key} recorded in only {len(values)}/{len(rows)} frames")

    # Missing counters in older reports are unknown, rather than zero work.
    for key in ("projectiles", "effects", "sprite_features", "in_view_burning_features"):
        values = [sample[key] for sample in census if key in sample]
        if len(values) == len(rows) and not any(values):
            print(f"WARNING: measured workload has no {key}")
    construction_keys = ("builds", "nanoframes", "nanolathe_events")
    if metadata.get("factories") and all(any(key in sample for key in construction_keys) for sample in census):
        if not any(sample.get(key, 0) for sample in census for key in construction_keys):
            print("WARNING: factories requested but no construction observed in measured frames")

    for owner in (0, 1):
        active = [sum(f["Owner"] == owner and f["Phase"] == 3 and f["Target"] != 0
                      for f in sample.get("factory_production", [])) for sample in census]
        print(f"owner {owner} active factories: {min(active)}..{max(active)}")
